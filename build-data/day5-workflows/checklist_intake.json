      ],
      "id": "불량 있음?"
    },
    {
      "parameters": {
        "resource": "message",
        "operation": "post",
        "select": "channel",
        "channelId": {
          "__rl": true,
          "mode": "name",
          "value": "정비-알림"
        },
        "text": "=:rotating_light: 점검표 불량 발견\n장비: {{ $json['장비ID'] }} / 점검일자: {{ $json['점검일자'] }}\n불량 {{ $json['불량수'] }}건 — {{ $json['불량항목'] }}\n점검자: {{ $json['점검자'] }} / 특이사항: {{ $json['특이사항'] }}",
        "otherOptions": {}
      },
