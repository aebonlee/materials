# 이 파일을 복사해 .env 로 만든 뒤 여러분의 값으로 채웁니다.
#   cp .env.example .env
#
# .env 는 깃허브에 올라가지 않습니다(.gitignore). 화면 공유·캡처에서도 가리세요.

# ── Supabase (Settings → API 에서 복사) ─────────────────────────────
VITE_SUPABASE_URL=https://여러분프로젝트.supabase.co
VITE_SUPABASE_ANON_KEY=여기에_anon_public_키

# ── 함수 호출용 표식 ────────────────────────────────────────────────
# API 키가 아닙니다. 완전히 공개된 주소에 아무나 붙는 것을 걸러 내는 약한 방어선입니다.
# 빌드 결과에 그대로 들어가므로 비밀이 아닙니다 — 아무 긴 문자열이나 정하고,
# Supabase 함수 secret 의 BOT_CLIENT_TOKEN 과 **똑같은 값**으로 맞추면 됩니다.
VITE_BOT_CLIENT_TOKEN=아무_긴_문자열_하나_정하세요

# ── 아래 둘은 절대 여기에 쓰지 않습니다 ─────────────────────────────
# SOLAR_API_KEY / OPENAI_API_KEY 는 Supabase 대시보드의
# Edge Functions → Secrets 에만 넣습니다. 프런트에 넣으면 그대로 노출됩니다.
