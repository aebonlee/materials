   "name": "수집 시트 읽기"
  },
  {
   "parameters": {
    "jsCode": "\n// 수집 시트의 모든 행을 읽어 지표를 계산한다.\nconst rows = $input.all().map(i => i.json);\nconst total = rows.length;\n\n// 필수 칸 — 비어 있으면 못 읽은 것\nconst 필수 = ['장비ID', '점검일자', '점검자'];\nlet 필수결측 = 0;\nfor (const r of rows) for (const c of 필수) if (!String(r[c] ?? '').trim()) 필수결측++;\n\n// 전체 칸 — 적을 것이 없어 비는 칸까지 포함\nconst 전체 = ['장비ID', '점검일자', '점검자', '불량항목', '특이사항'];\nlet 전체결측 = 0;\nfor (const r of rows) for (const c of 전체) if (!String(r[c] ?? '').trim()) 전체결측++;\n\nconst 불량건 = rows.filter(r => Number(r['불량수']) > 0).length;\n\n// 최근 7일 제출 건수\nconst 기준 = new Date($now.toISO());\nconst 최근7일 = rows.filter(r => {\n  const t = new Date(String(r['제출시각']).replace(' ', 'T'));\n  return !isNaN(t) && (기준 - t) / 86400000 <= 7;\n}).length;\n\n// 불량이 잦은 장비 상위 3\nconst 장비별 = {};\nfor (const r of rows) if (Number(r['불량수']) > 0) 장비별[r['장비ID']] = (장비별[r['장비ID']] || 0) + 1;\nconst 상위 = Object.entries(장비별).sort((a, b) => b[1] - a[1]).slice(0, 3)\n  .map(([k, v]) => `${k}(${v})`).join(' · ');\n\nreturn [{ json: {\n  집계일자: $now.toFormat('yyyy-MM-dd'),\n  총건수: total,\n  최근7일: 최근7일,\n  필수칸_결측률: Number((필수결측 / (total * 필수.length) * 100).toFixed(1)),\n  전체칸_결측률: Number((전체결측 / (total * 전체.length) * 100).toFixed(1)),\n  불량건수: 불량건,\n  불량비율: Number((불량건 / total * 100).toFixed(1)),\n  불량_상위장비: 상위\n}}];\n"
   },
   "type": "n8n-nodes-base.code",
